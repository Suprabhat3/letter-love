# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# SERVER ONLY. Project Settings -> API -> service_role. This key bypasses RLS
# entirely, so it must never be prefixed NEXT_PUBLIC_ and never imported from a
# client component (lib/supabase-server.ts imports "server-only" to make that a
# build error). Required: since migration 0002 there is no public SELECT policy
# on `cards`, so without this every share link 404s.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# SERVER ONLY. Salt for hashing rate-limit subjects (and, in Phase 4, viewer
# ids). Any long random string. Changing it resets today's counters.
VIEWER_SALT=change_me_to_a_long_random_string

# Google Gemini (used via the OpenAI-compatible endpoint) for the AI routes.
# Still set a hard quota on this key in Google Cloud. The routes are now rate
# limited per day (per hashed IP for enhance, per user for whole letters), but
# that counter fails OPEN by design — if the database is unreachable, requests
# are allowed through rather than taking the product down. The Google-side
# quota is the only cap that cannot fail open.
GEMINI_API_KEY=your_gemini_api_key

# Optional: Base URL for share links (defaults to localhost in dev)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
